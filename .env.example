# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ── Datastores ───────────────────────────────────────────────────────────────
# When DATABASE_URL is unset the server falls back to an in-memory repository.
DATABASE_URL=postgres://voice2spec:voice2spec@localhost:5432/voice2spec
# When REDIS_URL is unset the server falls back to an in-memory session store.
REDIS_URL=redis://localhost:6379

# ── AI providers ─────────────────────────────────────────────────────────────
# When these are unset the corresponding service uses a deterministic mock,
# so the full pipeline runs offline with no API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Deepgram enables real live (streaming) speech-to-text over the WebSocket.
DEEPGRAM_API_KEY=
WHISPER_MODEL=whisper-1
CLAUDE_MODEL=claude-3-5-sonnet-latest
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=multi

# ── Security ─────────────────────────────────────────────────────────────────
# 32-byte master key (base64 or hex). A dev default is used if unset.
MASTER_ENCRYPTION_KEY=
# Default Zero-Retention behaviour for new sessions.
ZERO_RETENTION_DEFAULT=false
